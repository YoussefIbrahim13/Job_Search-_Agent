# ┌─────────────────────────────────────────────────────────┐
# │   RecruitBot — Environment Variables (template)          │
# └─────────────────────────────────────────────────────────┘
#
# Copy to `.env` and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored and MUST NEVER be committed. If you believe a key has
# been committed or otherwise exposed, treat it as burned: rotate it at the
# provider first, then clean the history. Rewriting history does not un-leak a
# key — forks and clone caches keep the old blob.
#
# Every variable below maps to a field on `Settings` in backend/core/config.py.
# Names are case-insensitive. Anything left unset falls back to the default
# shown in the comment, so a minimal working `.env` is just the two REQUIRED
# keys.


# ── REQUIRED ────────────────────────────────────────────────────────────────

# LLM provider. Free tier at https://console.groq.com — the key looks like
# "gsk_...". Without this the app exits at startup.
GROQ_API_KEY=

# Web search provider used to find job postings. Free tier at
# https://app.tavily.com — the key looks like "tvly-...". Without this,
# searches return nothing.
TAVILY_API_KEY=


# ── AI MODEL ────────────────────────────────────────────────────────────────

# Groq model id. The 70B model is what the prompts and token budgets in
# backend/agents/ are tuned for; smaller models degrade JSON reliability.
# Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile


# ── SEARCH TUNING ───────────────────────────────────────────────────────────

# Results requested per Tavily query. Tavily bills per SEARCH rather than per
# result, so raising this is close to free; the real ceiling is the character
# budget in tools.MAX_RESULT_CHARS, which decides how many reach the model.
# Default: 15
TAVILY_MAX_RESULTS=15

# Crawl-date window handed to Tavily's `time_range` parameter.
# One of: day | week | month | year. Use "week" for a stricter "hiring now"
# bias. Note this is CRAWL date, not posting date — the content-layer
# staleness filter in tools.py is what catches old-but-recently-crawled pages.
# Default: month
TAVILY_TIME_RANGE=month

# Maximum LangGraph agent loop iterations. Must stay above the number of
# planned queries (2) with headroom, or one transient Groq 429 consumes the
# whole budget and the run falls back to degraded ToolMessage recovery.
# Default: 4
MAX_AGENT_ITERATIONS=4

# Characters of CV text forwarded to the LLM. Guards the context window; the
# full text is never persisted to disk.
# Default: 2000
MAX_CV_CHARS=2000


# ── STRUCTURED JOB SOURCES (Phase 2) ────────────────────────────────────────

# JSearch via RapidAPI — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
#
# The primary structured provider. It aggregates Google for Jobs, which is the
# only realistic route to Egypt/MENA coverage with real posting dates and
# numeric salaries. Those two fields are what make deterministic ranking
# possible at all; the search-snippet path could never produce them.
#
# OPTIONAL. Leave it empty and the adapter reports itself unsupported, so the
# registry falls through to the free providers. The app keeps working without a
# RapidAPI account, with weaker data.
JSEARCH_API_KEY=

# RapidAPI host header. Only change this if RapidAPI re-hosts the API.
# Default: jsearch.p.rapidapi.com
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# Requests per day. The free tier is a few hundred per MONTH, so a daily
# ceiling is what stops one busy afternoon from consuming the month. Checked
# before the call, so it protects the budget rather than just reporting on it.
# Default: 20
JSEARCH_DAILY_QUOTA=20

# Per-request timeout in seconds for any job-source HTTP call. Deliberately
# short: providers are queried concurrently, so a slow one should drop out and
# let the others answer instead of holding up the whole search.
# Default: 10.0
SOURCE_HTTP_TIMEOUT=10.0

# Total seconds any single provider may take, across however many HTTP requests
# it makes internally. Separate from SOURCE_HTTP_TIMEOUT because an adapter can
# issue several calls (Arbeitnow walks pages), so a per-request limit does not
# bound one provider's total contribution to how long a search takes.
# Default: 25.0
SOURCE_PROVIDER_TIMEOUT=25.0

# Circuit breaker. After this many consecutive failures a provider is skipped
# entirely for the cooldown period. Without it, every search pays the full
# timeout to rediscover an outage that is already known — and the user waits
# for it each time.
# Defaults: 3 failures, 300s cooldown
SOURCE_BREAKER_THRESHOLD=3
SOURCE_BREAKER_COOLDOWN=300.0

# Cooldown after a provider refuses on quota (HTTP 429). Much longer than the
# failure cooldown on purpose: a 429 against a monthly cap will still be a 429
# in five minutes, and retrying only burns whatever budget is left.
# Default: 3600.0
SOURCE_QUOTA_COOLDOWN=3600.0


# ── RANKING: LLM SEMANTIC PASS ──────────────────────────────────────────────
#
# The last 10 of 100 ranking points. Location, recency, salary, seniority and
# skill overlap are all compared in code — reproducibly and for free. The model
# is asked one question those rules cannot answer: is this posting the same
# KIND of role as the candidate's background?
#
# Setting this to false costs those 10 points and nothing else. The
# deterministic scorer stands alone, which is the whole point of the split, and
# it is also the automatic behaviour whenever Groq is unreachable.
# Default: true
SEMANTIC_PASS_ENABLED=true

# How many top-ranked candidates the pass looks at. Cost scales linearly with
# this. It runs after deterministic ranking, so the jobs below the cut are ones
# already judged poor matches on facts — tokens spent there change no ordering.
# Default: 15
SEMANTIC_MAX_JOBS=15

# Description characters sent per job. Enough to judge the role, short enough
# that fifteen of them fit comfortably in a single request.
# Default: 600
SEMANTIC_DESCRIPTION_CHARS=600


# ── SERVER ──────────────────────────────────────────────────────────────────

# Comma-separated list of browser origins allowed to call the API.
#
# Do NOT set this to "*". The wildcard is invalid in combination with
# `allow_credentials=True` — browsers reject such responses outright — and it
# would break the cookie-based auth this setting is a prerequisite for. The SPA
# is served same-origin from the same FastAPI process, so in the default
# deployment CORS never engages at all; these entries exist for split dev
# setups (e.g. a Vite dev server on another port).
# Default: http://localhost:8888,http://127.0.0.1:8888
CORS_ORIGINS=http://localhost:8888,http://127.0.0.1:8888

# Root log level: DEBUG | INFO | WARNING | ERROR.
#
# PRIVACY: DEBUG emits CV-derived content — detected job title, extracted skill
# list, uploaded filename (which routinely contains the candidate's real name),
# and full model output. The UI promises users their CV is not stored. Keep
# this at INFO or above anywhere logs are shared, shipped, or retained.
# Default: INFO
LOG_LEVEL=INFO


# ── LOCAL LLM VIA OLLAMA (optional, currently disabled in code) ─────────────
#
# The Ollama fields in backend/core/config.py are commented out, so these are
# inert until that code is re-enabled. Left here as documentation of intent.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b


# ── PHASE 4 — MULTI-USER (not yet implemented) ──────────────────────────────
#
# These are NOT read by Settings today. They are listed so the deployment story
# is visible ahead of time; adding them to `.env` now has no effect.
#
# Postgres connection string. Postgres rather than SQLite from the start:
# JSONB, real concurrent writes, pg_trgm for fuzzy title matching, and pgvector
# later for semantic matching.
# DATABASE_URL=postgresql+psycopg://recruitbot:password@localhost:5432/recruitbot
#
# Redis, for session storage and the provider-response cache.
# REDIS_URL=redis://localhost:6379/0
#
# Secret used to sign session cookies. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Startup must FAIL in production if this is unset or left at a default.
# SESSION_SECRET=
#
# Deployment environment: development | staging | production.
# Gates the production-only config validators.
# ENVIRONMENT=development
